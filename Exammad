public class RegistrationActivity extends AppCompatActivity {

    EditText name, reg, email, mobile, course;
    Button submit, reset;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_registration);

        name = findViewById(R.id.name);
        reg = findViewById(R.id.reg);
        email = findViewById(R.id.email);
        mobile = findViewById(R.id.mobile);
        course = findViewById(R.id.course);

        submit = findViewById(R.id.submit);
        reset = findViewById(R.id.reset);

        submit.setOnClickListener(v -> {
            String n = name.getText().toString();
            String r = reg.getText().toString();
            String e = email.getText().toString();
            String m = mobile.getText().toString();
            String c = course.getText().toString();

            if (n.isEmpty() || r.isEmpty() || e.isEmpty()
                    || m.isEmpty() || c.isEmpty()) {
                Toast.makeText(this, "Fill all fields",
                        Toast.LENGTH_SHORT).show();
            } else {
                Intent i = new Intent(RegistrationActivity.this,
                                      DetailsActivity.class);

                i.putExtra("name", n);
                i.putExtra("reg", r);
                i.putExtra("email", e);
                i.putExtra("mobile", m);
                i.putExtra("course", c);

                startActivity(i);
            }
        });

        reset.setOnClickListener(v -> {
            name.setText("");
            reg.setText("");
            email.setText("");
            mobile.setText("");
            course.setText("");
        });
    }
}


public class DetailsActivity extends AppCompatActivity {

    TextView details;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_details);

        details = findViewById(R.id.details);

        String n = getIntent().getStringExtra("name");
        String r = getIntent().getStringExtra("reg");
        String e = getIntent().getStringExtra("email");
        String m = getIntent().getStringExtra("mobile");
        String c = getIntent().getStringExtra("course");

        details.setText("Name: " + n +
                "\nRegister No: " + r +
                "\nEmail: " + e +
                "\nMobile: " + m +
                "\nCourse: " + c);
    }
}


